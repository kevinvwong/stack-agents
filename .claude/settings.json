{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start.sh",
            "timeout": 30,
            "statusMessage": "Loading session briefing...",
            "async": false
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/bash-guard.sh",
            "timeout": 10,
            "statusMessage": "Checking Bash command safety..."
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/lint-references-on-commit.sh",
            "timeout": 30,
            "statusMessage": "Linting [AGENT:] and /cmd: references..."
          }
        ]
      },
      {
        "matcher": "mcp__.*notion-(create-pages|update-page)",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/notion-url-sanitize.sh",
            "timeout": 5,
            "statusMessage": "Scanning Notion payload for credentials..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/format-on-write.sh",
            "timeout": 15,
            "statusMessage": "Formatting file...",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-stop.sh",
            "timeout": 10,
            "statusMessage": "Writing session state...",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/notify.sh",
            "timeout": 5,
            "statusMessage": "Sending notification...",
            "async": true
          }
        ]
      }
    ]
  }
}
